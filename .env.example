# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# Local-first default: point this at your local GPT auth/API proxy, Ollama, LM Studio, vLLM, etc.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL_NAME=gpt-4o-mini

# ===== Graph memory / GraphRAG provider =====
# local_simple: ZEP-free JSON/JSONL bootstrap backend, works with docker compose up
# zep: original Zep Cloud behavior, requires ZEP_API_KEY
# graphiti: local Graphiti/Graphifi adapter via the graph-memory compose profile
GRAPH_PROVIDER=local_simple
LOCAL_GRAPH_STORAGE_DIR=/app/backend/uploads/local_graphs
GRAPH_MEMORY_BASE_URL=http://graph-memory:8000
GRAPHITI_BASE_URL=http://graph-memory:8000

# ===== ZEP记忆图谱配置（仅 GRAPH_PROVIDER=zep 时需要）=====
# ZEP_API_KEY=your_zep_api_key_here

# ===== Embedding endpoint hooks（后续 Graphiti/GraphRAG/semantic search 用）=====
EMBEDDING_API_KEY=local-no-auth
EMBEDDING_BASE_URL=http://host.docker.internal:8089/v1
EMBEDDING_MODEL_NAME=jina-embeddings-v5-small

# ===== Multimodal endpoint hooks（后续图像/多模态分析用）=====
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=http://host.docker.internal:11434/v1
MULTIMODAL_MODEL_NAME=llava

# ===== Optional Graphiti/Neo4j compose profile =====
GRAPH_MEMORY_OPENAI_API_KEY=${LLM_API_KEY}
GRAPH_MEMORY_OPENAI_BASE_URL=${LLM_BASE_URL}
GRAPH_MEMORY_MODEL_NAME=${LLM_MODEL_NAME}
GRAPH_MEMORY_EMBEDDING_MODEL_NAME=${EMBEDDING_MODEL_NAME}
GRAPH_MEMORY_EMBEDDING_BASE_URL=${EMBEDDING_BASE_URL}
GRAPH_MEMORY_EMBEDDING_API_KEY=${EMBEDDING_API_KEY}
GRAPH_MEMORY_EMBEDDING_DIM=1024
NEO4J_PASSWORD=mirofish_local_password

# ===== Frontend dev server proxy =====
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://localhost:5001

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
