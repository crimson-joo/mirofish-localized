# LLM API configuration (OpenAI SDK-compatible endpoint)
# For this machine the default is the local GPT auth/API proxy. Other users can point to OpenAI, Ollama, LM Studio, vLLM, etc.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=http://host.docker.internal:10531/v1
LLM_MODEL_NAME=gpt-5.5
# Fail closed instead of hanging indefinitely on long report/profile calls.
LLM_TIMEOUT_SECONDS=180

# ===== Graph memory / GraphRAG provider =====
# graphiti is the default product runtime. With current docker-compose.yml, Graphiti + Neo4j start with plain `docker compose up`.
# MiroFish talks to bundled Graphiti by service name inside Docker, so a separate host Graphiti process is not required.
GRAPH_PROVIDER=graphiti
LOCAL_GRAPH_STORAGE_DIR=/app/backend/uploads/local_graphs
GRAPH_MEMORY_BASE_URL=http://graph-memory:8000
GRAPHITI_BASE_URL=http://graph-memory:8000

# ===== ZEP memory graph configuration (only needed when GRAPH_PROVIDER=zep) =====
# ZEP_API_KEY=your_zep_api_key_here

# ===== Embedding endpoint hooks (Graphiti/GraphRAG/semantic search) =====
EMBEDDING_API_KEY=local-no-auth
EMBEDDING_BASE_URL=http://host.docker.internal:8089/v1
EMBEDDING_MODEL_NAME=jina-embeddings-v5-small

# ===== Multimodal endpoint hooks =====
# Image uploads and visually rich PDF pages are analyzed through this endpoint before Ontology/Graphiti ingestion.
# gemma4:12b-mlx is for Ollama on the Apple/macOS host; Docker containers should reach it through host.docker.internal.
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=http://host.docker.internal:11434/v1
MULTIMODAL_MODEL_NAME=gemma4:12b-mlx
PDF_MULTIMODAL_ANALYSIS=true
PDF_MULTIMODAL_MAX_PAGES=6
PDF_MULTIMODAL_DPI=96
MULTIMODAL_MAX_TOKENS=768
# If you run Ollama inside Docker instead of Apple host MLX, use a non-MLX tag and start with --profile ollama.
OLLAMA_MULTIMODAL_MODEL=gemma4:12b

# ===== Bundled Graphiti/Neo4j configuration =====
GRAPH_MEMORY_OPENAI_API_KEY=${LLM_API_KEY}
GRAPH_MEMORY_OPENAI_BASE_URL=${LLM_BASE_URL}
GRAPH_MEMORY_MODEL_NAME=${LLM_MODEL_NAME}
# Optional hardening: use a stricter structured-output model for Graphiti's small-model extraction pass.
GRAPH_MEMORY_SMALL_MODEL_NAME=${GRAPH_MEMORY_MODEL_NAME}
GRAPH_MEMORY_EMBEDDING_MODEL_NAME=${EMBEDDING_MODEL_NAME}
GRAPH_MEMORY_EMBEDDING_BASE_URL=${EMBEDDING_BASE_URL}
GRAPH_MEMORY_EMBEDDING_API_KEY=${EMBEDDING_API_KEY}
GRAPH_MEMORY_EMBEDDING_DIM=1024
NEO4J_PASSWORD=mirofish_local_password

# ===== Frontend dev server proxy =====
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://localhost:5001

# ===== Optional accelerated LLM configuration =====
# If unused, do not define these variables.
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
